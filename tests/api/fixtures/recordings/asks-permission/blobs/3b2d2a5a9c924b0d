[{"name":"Agent","description":"Launch a sub-agent to handle complex, multi-step tasks independently.\n\nAvailable subagent_type values:\n- claude: Claude AI assistant with full tool access\n- code-reviewer: Code review specialist using Read/Grep/Glob/LSP/Bash\n- explore: Read-only file search and exploration specialist\n- general-purpose: General-purpose AI coding agent with full tool access\n- plan: Software architect and planning specialist\n- worker: Worker agent executing a precisely-scoped task within a team\n\nDetailed guide: ToolSearch{\"query\":\"select:Agent\"}","input_schema":{"$defs":{"PermissionMode":{"description":"Permission mode for tool execution.","oneOf":[{"const":"default","description":"Prompt user for each tool call that isn't explicitly allowed.","type":"string"},{"const":"acceptEdits","description":"Auto-accept edits to files (Write/Edit), prompt for others.","type":"string"},{"const":"bypassPermissions","description":"Bypass all permission checks.","type":"string"},{"const":"plan","description":"Plan mode — only allow read-only tools.","type":"string"},{"const":"auto","description":"Auto mode — skip prompts for known-safe operations.\n**Program-only**: requires transcript classifier; cannot be set by user.","type":"string"},{"const":"dontAsk","description":"Don't ask — deny any tool not explicitly allowed (no prompt).","type":"string"},{"const":"bubble","description":"Bubble mode — forward permission requests up to a parent agent.\n**Program-only**: set by team/coordinator runtime; cannot be set by user.","type":"string"},{"const":"yolo","description":"YOLO mode — aggressive auto-approval for power users.","type":"string"}]}},"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"auto_background_after_secs":{"default":null,"format":"uint64","minimum":0,"type":["integer","null"]},"background":{"default":false,"type":"boolean"},"description":{"default":null,"type":["string","null"]},"model":{"default":null,"type":["string","nu